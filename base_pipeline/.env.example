# Google Gemini API Key (Required for real-time speech-to-speech Gemini Live)
GEMINI_API_KEY=your_gemini_api_key_here
MODEL=gemini-3.1-flash-live-preview
VOICE_ID=Puck

# Groq API Key (Required for high-speed secondary text inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Server Hosting Configuration
HOST=0.0.0.0
PORT=8000

# GitHub Integration (Optional: increases GitHub REST API rate limits from 60 to 5000/hr)
GITHUB_PAT=
GITHUB_USERNAME=Cyberpradeep

# SMTP Email Configuration (Required for automated resume and contact email dispatch)
SENDER_EMAIL=
SENDER_PASSWORD=
