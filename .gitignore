# Ignore everything by default so only the base_pipeline tree is considered.
*

# Ignore environment files everywhere.
.env
**/.env

# Keep the ignore file itself.
!/.gitignore
!/Procfile
!/requirements.txt
!/README.md
!/render.yaml

# Allow the base_pipeline project files.
!/base_pipeline/
!/base_pipeline/**

# Ignore data backups and zip files
base_pipeline/**/data_backup_old/
base_pipeline/**/data_backup_old/**
*.zip

base_pipeline/frontend/tv_preview*
